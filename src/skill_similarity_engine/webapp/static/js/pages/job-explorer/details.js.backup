/**
 * Job Explorer - Job Details Display
 * Handles job profile display, skills visualization, and detailed information
 */

window.SkillEngine = window.SkillEngine || {};

SkillEngine.JobDetails = {
    /**
     * Show job profile and hide welcome state
     */
    showJobProfile(selectedJob) {
        console.log(`🔧 DEBUG: showJobProfile called for job:`, selectedJob);
        
        const welcomeState = document.getElementById('welcome-state');
        const jobProfileContent = document.getElementById('job-profile-content');
        const gettingStartedPanel = document.getElementById('getting-started-panel');
        const jobArchitecturePanel = document.getElementById('job-architecture-panel');

        console.log(`🔧 DEBUG: Elements found:`, {
            welcomeState: !!welcomeState,
            jobProfileContent: !!jobProfileContent,
            gettingStartedPanel: !!gettingStartedPanel,
            jobArchitecturePanel: !!jobArchitecturePanel
        });

        if (welcomeState) {
            welcomeState.classList.add('hidden');
            console.log(`🔧 DEBUG: Hidden welcome state`);
        }
        if (jobProfileContent) {
            jobProfileContent.classList.remove('hidden');
            console.log(`🔧 DEBUG: Showed job profile content`);
        }
        if (gettingStartedPanel) {
            gettingStartedPanel.classList.add('hidden');
            console.log(`🔧 DEBUG: Hidden getting started panel`);
        }
        if (jobArchitecturePanel) {
            jobArchitecturePanel.classList.remove('hidden');
            console.log(`🔧 DEBUG: Showed job architecture panel`);
        }

        // Load job details
        this.loadJobDetails(selectedJob.id);
        
        // Enable export button
        this.enableExportButton();
    },
    
    /**
     * Enable the export button and bind event handler
     */
    enableExportButton() {
        const exportBtn = document.getElementById('export-csv-btn');
        if (exportBtn) {
            exportBtn.disabled = false;
            exportBtn.title = 'Export job profile analysis to CSV';
            
            // Remove any existing event listeners and add new one
            exportBtn.replaceWith(exportBtn.cloneNode(true));
            const newExportBtn = document.getElementById('export-csv-btn');
            newExportBtn.addEventListener('click', () => this.exportJobProfileToCSV());
        }
    },

    /**
     * Load job details
     */
    async loadJobDetails(jobId) {
        const selectedJob = SkillEngine.JobExplorerController.state.selectedJob;
        
        // Update job header
        SkillEngine.DOMHelpers.updateElementText('job-title-header', selectedJob.title);
        SkillEngine.DOMHelpers.updateElementText('job-function-badge', selectedJob.function);
        SkillEngine.DOMHelpers.updateElementText('job-function-id-badge', selectedJob.function_id || 'N/A');
        SkillEngine.DOMHelpers.updateElementText('job-profile-id', selectedJob.id);

        // Update sidebar quick stats
        this.updateSidebarInfo();

        // Load detailed data
        await Promise.all([
            this.loadJobSkills(jobId),
            this.loadWorkforceContext(jobId),
            this.loadCareerPathways(jobId),
            this.loadJobIntelligence(jobId)
        ]);
    },

    /**
     * Update sidebar information
     */
    updateSidebarInfo() {
        const job = SkillEngine.JobExplorerController.state.selectedJob;
        
        SkillEngine.DOMHelpers.updateElementText('sidebar-job-profile-id', job.id);
        SkillEngine.DOMHelpers.updateElementText('sidebar-job-profile', job.title);
        SkillEngine.DOMHelpers.updateElementText('sidebar-job-id', job.id);
        SkillEngine.DOMHelpers.updateElementText('sidebar-job-name', job.title);
        SkillEngine.DOMHelpers.updateElementText('sidebar-job-function', job.function);
        SkillEngine.DOMHelpers.updateElementText('sidebar-job-function-id', job.function_id || 'N/A');
    },

    /**
     * Load job skills and related data
     */
    async loadJobSkills(jobId) {
        try {
            const data = await SkillEngine.ApiClient.getJobDetails(jobId);
            
            if (data.error) {
                console.error('Error loading job details:', data.error);
                return;
            }

            // Update sidebar stats
            SkillEngine.DOMHelpers.updateElementText('sidebar-skills-count', data.stats.skills_count);
            SkillEngine.DOMHelpers.updateElementText('sidebar-positions-count', data.stats.positions_count);
            SkillEngine.DOMHelpers.updateElementText('sidebar-employees-count', data.stats.employee_count);
            SkillEngine.DOMHelpers.updateElementText('sidebar-pathways-count', data.stats.pathways_count);

            // Update detailed job architecture info
            this.updateJobArchitectureDetails(data.job);

            // Update header badges
            this.updateHeaderBadges(data.job);

            // Display skills
            await this.displaySkills(data.skills);

        } catch (error) {
            console.error('Error loading job skills:', error);
        }
    },

    /**
     * Update job architecture details in sidebar
     */
    updateJobArchitectureDetails(job) {
        const updates = {
            'sidebar-job-profile-id': job.id,
            'sidebar-job-profile': job.title,
            'sidebar-job-id': job.job_id || '-',
            'sidebar-job-name': job.job_name || '-',
            'sidebar-job-function': job.function,
            'sidebar-job-function-id': job.function_id || '-',
            'sidebar-profile-title-suffix': job.profile_title_suffix || '-',
            'sidebar-management-level': job.management_level || '-',
            'sidebar-job-category': job.job_category || '-',
            'sidebar-job-subfunction': job.job_subfunction || '-'
        };

        Object.entries(updates).forEach(([id, value]) => {
            SkillEngine.DOMHelpers.updateElementText(id, value);
        });

        // Handle conditional fields
        this.updateConditionalFields(job);
    },

    /**
     * Update conditional fields that only show when data exists
     */
    updateConditionalFields(job) {
        const conditionalFields = document.getElementById('sidebar-conditional-fields');
        let hasConditionalData = false;

        // Customer Facing
        const customerFacingRow = document.getElementById('customer-facing-row');
        if (job.customer_facing) {
            customerFacingRow.classList.remove('hidden');
            SkillEngine.DOMHelpers.updateElementText('sidebar-customer-facing', job.customer_facing);
            hasConditionalData = true;
        } else {
            customerFacingRow.classList.add('hidden');
        }

        // Banking Role
        const bankerRow = document.getElementById('is-banker-row');
        if (job.is_banker) {
            bankerRow.classList.remove('hidden');
            SkillEngine.DOMHelpers.updateElementText('sidebar-is-banker', job.is_banker);
            hasConditionalData = true;
        } else {
            bankerRow.classList.add('hidden');
        }

        // Executive Leadership
        const executiveRow = document.getElementById('executive-leadership-row');
        if (job.executive_leadership_group) {
            executiveRow.classList.remove('hidden');
            hasConditionalData = true;
        } else {
            executiveRow.classList.add('hidden');
        }

        // Accountability Scope
        const accountabilityRow = document.getElementById('accountability-scope-row');
        if (job.accountability_scope) {
            accountabilityRow.classList.remove('hidden');
            SkillEngine.DOMHelpers.updateElementText('sidebar-accountability-scope', job.accountability_scope);
            hasConditionalData = true;
        } else {
            accountabilityRow.classList.add('hidden');
        }

        // Show/hide conditional fields section
        if (hasConditionalData) {
            conditionalFields.classList.remove('hidden');
        } else {
            conditionalFields.classList.add('hidden');
        }
    },

    /**
     * Update header badges
     */
    updateHeaderBadges(job) {
        // Management level badge
        const managementBadge = document.getElementById('management-level-badge');
        if (job.management_level) {
            managementBadge.textContent = job.management_level;
            managementBadge.classList.remove('hidden');
        } else {
            managementBadge.classList.add('hidden');
        }

        // Job category badge
        const categoryBadge = document.getElementById('job-category-badge');
        if (job.job_category) {
            categoryBadge.textContent = job.job_category;
            categoryBadge.classList.remove('hidden');
        } else {
            categoryBadge.classList.add('hidden');
        }
    },

    /**
     * Generate dynamic styling for category based on its name
     */
    generateCategoryStyle(categoryName) {
        // Create a simple hash from the category name
        let hash = 0;
        for (let i = 0; i < categoryName.length; i++) {
            const char = categoryName.charCodeAt(i);
            hash = ((hash << 5) - hash) + char;
            hash = hash & hash; // Convert to 32-bit integer
        }
        
        // Use the hash to select from predefined color palettes
        const colorPalettes = [
            { bg: 'bg-blue-100', text: 'text-blue-800', border: 'border-blue-200', accent: 'bg-blue-500' },
            { bg: 'bg-indigo-100', text: 'text-indigo-800', border: 'border-indigo-200', accent: 'bg-indigo-500' },
            { bg: 'bg-purple-100', text: 'text-purple-800', border: 'border-purple-200', accent: 'bg-purple-500' },
            { bg: 'bg-pink-100', text: 'text-pink-800', border: 'border-pink-200', accent: 'bg-pink-500' },
            { bg: 'bg-red-100', text: 'text-red-800', border: 'border-red-200', accent: 'bg-red-500' },
            { bg: 'bg-orange-100', text: 'text-orange-800', border: 'border-orange-200', accent: 'bg-orange-500' },
            { bg: 'bg-amber-100', text: 'text-amber-800', border: 'border-amber-200', accent: 'bg-amber-500' },
            { bg: 'bg-yellow-100', text: 'text-yellow-800', border: 'border-yellow-200', accent: 'bg-yellow-500' },
            { bg: 'bg-lime-100', text: 'text-lime-800', border: 'border-lime-200', accent: 'bg-lime-500' },
            { bg: 'bg-green-100', text: 'text-green-800', border: 'border-green-200', accent: 'bg-green-500' },
            { bg: 'bg-emerald-100', text: 'text-emerald-800', border: 'border-emerald-200', accent: 'bg-emerald-500' },
            { bg: 'bg-teal-100', text: 'text-teal-800', border: 'border-teal-200', accent: 'bg-teal-500' },
            { bg: 'bg-cyan-100', text: 'text-cyan-800', border: 'border-cyan-200', accent: 'bg-cyan-500' },
            { bg: 'bg-sky-100', text: 'text-sky-800', border: 'border-sky-200', accent: 'bg-sky-500' }
        ];
        
        // Generate consistent emoji based on category keywords
        const categoryEmojis = {
            'analysis': '📊', 'technical': '⚙️', 'technology': '💻', 'it': '💻', 'data': '📈',
            'business': '💼', 'management': '👔', 'strategy': '🎯', 'planning': '📋',
            'customer': '🤝', 'client': '👥', 'service': '🛎️', 'support': '💬',
            'finance': '💰', 'accounting': '📊', 'banking': '🏦', 'money': '💵',
            'marketing': '📢', 'communication': '📞', 'media': '📺', 'public': '🗣️',
            'sales': '💰', 'revenue': '📈', 'selling': '🛒',
            'legal': '⚖️', 'compliance': '📋', 'regulation': '📝', 'law': '⚖️',
            'human': '👥', 'people': '👥', 'hr': '👥', 'resources': '🔧',
            'physical': '🧠', 'abilities': '💪', 'skills': '🔧'
        };
        
        // Find matching emoji
        const lowerCategory = categoryName.toLowerCase();
        let emoji = '🔧'; // default
        for (const [keyword, emojiIcon] of Object.entries(categoryEmojis)) {
            if (lowerCategory.includes(keyword)) {
                emoji = emojiIcon;
                break;
            }
        }
        
        const paletteIndex = Math.abs(hash) % colorPalettes.length;
        const palette = colorPalettes[paletteIndex];
        
        return {
            ...palette,
            emoji: emoji
        };
    },

    /**
     * Display skills by category and as a complete list
     */
    async displaySkills(skills) {
        // Group skills by category
        const skillsByCategory = {};
        skills.forEach(skill => {
            const category = skill.category || 'Other';
            if (!skillsByCategory[category]) {
                skillsByCategory[category] = [];
            }
            skillsByCategory[category].push(skill);
        });

        // Get defining skills data for highlighting
        let definingSkillsData = [];
        try {
            const jobId = SkillEngine.JobExplorerController.state.selectedJob?.id;
            if (jobId) {
                const response = await fetch(`/api/v2/job-defining-skills/${jobId}`);
                if (response.ok) {
                    const apiResponse = await response.json();
                    // Extract the array from the API response structure
                    definingSkillsData = apiResponse.data?.all_defining_skills || [];
                    console.log('🔧 DEBUG: Loaded defining skills for highlighting:', definingSkillsData.length, 'skills');
                }
            }
        } catch (error) {
            console.warn('Could not load defining skills for highlighting:', error);
        }

        // Create a Set of defining skill names for quick lookup
        const definingSkillNames = new Set(definingSkillsData.map(skill => skill.skill_name));

        const skillsByCategoryContainer = document.getElementById('skills-by-category');
        if (skillsByCategoryContainer) {
            // Add legend for defining skills
            const legendHtml = definingSkillNames.size > 0 ? `
                <div class="mb-4 p-3 bg-yellow-50 border border-yellow-200 rounded-lg">
                    <div class="flex items-center">
                        <span class="text-yellow-600 text-sm font-medium mr-2">⭐ Legend:</span>
                        <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-semibold bg-gradient-to-r from-yellow-100 to-yellow-50 text-yellow-900 border border-yellow-300">
                            Defining Skills ★
                        </span>
                        <span class="ml-2 text-xs text-yellow-700">— Most important skills for this role</span>
                    </div>
                </div>
            ` : '';

            const html = legendHtml + Object.entries(skillsByCategory).map(([category, categorySkills]) => {
                const style = this.generateCategoryStyle(category);
                
                const skillsHtml = categorySkills.map(skill => {
                    const isDefining = definingSkillNames.has(skill.name);
                    
                    if (isDefining) {
                        return `<span class="inline-flex items-center px-3 py-1.5 rounded-md text-sm font-semibold bg-gradient-to-r from-yellow-100 to-yellow-50 text-yellow-900 border border-yellow-300 shadow-sm mr-2 mb-2" title="Defining skill for this role">
                            ${skill.name}
                            <span class="ml-1.5 text-yellow-600">★</span>
                        </span>`;
                    } else {
                        return `<span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium ${style.bg} ${style.text} ${style.border} border mr-2 mb-2 hover:shadow-sm transition-shadow" title="${skill.name}">
                            ${skill.name}
                        </span>`;
                    }
                }).join('');
                
                return `
                    <div class="mb-6 p-4 bg-white border border-gray-200 rounded-lg shadow-sm">
                        <div class="flex items-center mb-3 pb-2 border-b border-gray-100">
                            <div class="w-3 h-3 ${style.accent} rounded-full mr-3"></div>
                            <span class="text-lg mr-2">${style.emoji}</span>
                            <h4 class="text-base font-semibold text-gray-900">${category}</h4>
                            <span class="ml-auto px-3 py-1 ${style.bg} ${style.text} ${style.border} border text-sm rounded-full font-medium">
                                ${categorySkills.length} skills
                            </span>
                        </div>
                        <div class="flex flex-wrap">
                            ${skillsHtml}
                        </div>
                    </div>
                `;
            }).join('');
            
            skillsByCategoryContainer.innerHTML = html;
        }

        // Display complete skills list
        const skillsListContainer = document.getElementById('skills-complete-list');
        if (skillsListContainer) {
            const skillsHtml = skills.map(skill => 
                `<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium ${this.getSkillTypeClass(skill.category)} mr-2 mb-2">
                    ${skill.name}
                </span>`
            ).join('');
            
            skillsListContainer.innerHTML = skillsHtml;
        }
    },

    /**
     * Get CSS class for skill type
     */
    getSkillTypeClass(skillType) {
        const typeClasses = {
            'Technical': 'bg-blue-100 text-blue-800',
            'Leadership': 'bg-purple-100 text-purple-800', 
            'Communication': 'bg-green-100 text-green-800',
            'Analytical': 'bg-yellow-100 text-yellow-800',
            'Strategic': 'bg-red-100 text-red-800',
            'Operational': 'bg-indigo-100 text-indigo-800',
            'Interpersonal': 'bg-pink-100 text-pink-800',
            'Other': 'bg-gray-100 text-gray-800'
        };
        
        return typeClasses[skillType] || typeClasses['Other'];
    },

    /**
     * Load workforce context data using the same method as career pathways
     */
    async loadWorkforceContext(jobId) {
        try {
            // Use the same workforce analysis API as career pathways
            if (window.SkillEngine?.SkillsAnalysis) {
                // Use the skills analysis module to fetch and display workforce data
                // selectedStepIndex = 0 means show data for the first (and only) job
                await SkillEngine.SkillsAnalysis.fetchWorkforceAnalysis([jobId], 0, 'Selected job workforce distribution');
                
                // The skills analysis module will populate the workforce-pathway-table
                // and update the summary metrics using its displayWorkforceAnalysis method
                console.log('✅ Workforce context loaded via SkillsAnalysis module');
            } else {
                console.error('❌ SkillsAnalysis module not available');
                this.displayWorkforceError('Skills analysis module not loaded');
            }
            
        } catch (error) {
            console.error('Error loading workforce context:', error);
            this.displayWorkforceError(error.message);
        }
    },

    /**
     * Display workforce error state
     */
    displayWorkforceError(message) {
        // Update summary metrics to show error state
        SkillEngine.DOMHelpers.updateElementText('total-positions', '—');
        SkillEngine.DOMHelpers.updateElementText('divisions-represented', '—');
        SkillEngine.DOMHelpers.updateElementText('locations-spread', '—');
        
        // Update table to show error
        const workforceTable = document.getElementById('workforce-pathway-table');
        if (workforceTable) {
            workforceTable.innerHTML = `
                <tr>
                    <td colspan="4" class="px-3 py-8 text-center text-sm text-gray-500 break-words">
                        <div class="text-center p-4 bg-red-50 border border-red-200 rounded-lg">
                            <div class="text-sm text-red-800">
                                <strong>Unable to load workforce analysis</strong><br>
                                Error: ${message}
                            </div>
                        </div>
                    </td>
                </tr>
            `;
        }
    },

    /**
     * Display workforce context data in the new UI structure
     */
    displayWorkforceContext(data) {
        if (!data) {
            return;
        }

        // Update summary metrics
        const totalPositions = data.total_employees || 0;
        const divisionsCount = data.by_division ? data.by_division.length : 0;
        const locationsCount = data.by_location ? data.by_location.length : 0;

        SkillEngine.DOMHelpers.updateElementText('total-positions', totalPositions.toLocaleString());
        SkillEngine.DOMHelpers.updateElementText('divisions-represented', divisionsCount);
        SkillEngine.DOMHelpers.updateElementText('locations-spread', locationsCount);

        // Build the workforce table using combined data
        this.buildWorkforceTable(data);
    },

    /**
     * Build the organisational distribution table
     */
    buildWorkforceTable(data) {
        const tableBody = document.getElementById('workforce-pathway-table');
        if (!tableBody) return;

        // Clear existing content
        tableBody.innerHTML = '';

        if (!data || (!data.by_division && !data.by_business_unit && !data.by_location)) {
            tableBody.innerHTML = `
                <tr>
                    <td colspan="4" class="px-3 py-8 text-center text-sm text-gray-500 break-words">
                        No organisational distribution data available
                    </td>
                </tr>
            `;
            return;
        }

        // Create a comprehensive view using all available data
        const rows = [];

        // Add division rows
        if (data.by_division && data.by_division.length > 0) {
            data.by_division.forEach(item => {
                rows.push({
                    division: item.division || 'N/A',
                    business_unit: 'All Units',
                    location: 'All Locations', 
                    count: item.count || 0,
                    type: 'division'
                });
            });
        }

        // Add business unit rows
        if (data.by_business_unit && data.by_business_unit.length > 0) {
            data.by_business_unit.forEach(item => {
                rows.push({
                    division: 'Various',
                    business_unit: item.business_unit || 'N/A',
                    location: 'All Locations',
                    count: item.count || 0,
                    type: 'business_unit'
                });
            });
        }

        // Add location rows  
        if (data.by_location && data.by_location.length > 0) {
            data.by_location.forEach(item => {
                rows.push({
                    division: 'Various',
                    business_unit: 'All Units',
                    location: item.location || 'N/A',
                    count: item.count || 0,
                    type: 'location'
                });
            });
        }

        // Sort by count descending
        rows.sort((a, b) => b.count - a.count);

        // Add rows to table
        rows.forEach(row => {
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-gray-50 transition-colors duration-150';
            tr.innerHTML = `
                <td class="px-3 py-4 text-sm text-gray-900 break-words">${row.division}</td>
                <td class="px-3 py-4 text-sm text-gray-900 break-words">${row.business_unit}</td>
                <td class="px-3 py-4 text-sm text-gray-600 break-words">${row.location}</td>
                <td class="px-3 py-4 text-sm font-medium text-blue-600 break-words">${row.count}</td>
            `;
            tableBody.appendChild(tr);
        });
    },

    /**
     * Load career pathways for this job
     */
    async loadCareerPathways(jobId) {
        try {
            // First load the career pathways data from API
            await SkillEngine.CareerPathways.loadCareerPathways(jobId);
            
            // Then display the filtered results
            SkillEngine.CareerPathways.displayFilteredCareerPathways(
                jobId, 
                SkillEngine.JobExplorerController.state.currentSimilarityThreshold
            );
        } catch (error) {
            console.error('Error loading career pathways:', error);
        }
    },

    /**
     * Export job analysis
     */
    exportAnalysis(selectedJob) {
        // Create export data
        const exportData = {
            job: selectedJob,
            timestamp: new Date().toISOString(),
            analysis_type: 'job_explorer'
        };

        // Create and download file
        const dataStr = JSON.stringify(exportData, null, 2);
        const dataBlob = new Blob([dataStr], { type: 'application/json' });
        const url = URL.createObjectURL(dataBlob);
        
        const link = document.createElement('a');
        link.href = url;
        link.download = `job_analysis_${selectedJob.id}_${new Date().toISOString().split('T')[0]}.json`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        
        URL.revokeObjectURL(url);
    },

    /**
     * Load job intelligence analytics
     */
    async loadJobIntelligence(jobId) {
        try {
            if (SkillEngine.JobIntelligence && SkillEngine.JobIntelligence.loadJobIntelligence) {
                await SkillEngine.JobIntelligence.loadJobIntelligence(jobId);
            } else {
                console.warn('JobIntelligence module not available');
            }
        } catch (error) {
            console.error('Error loading job intelligence:', error);
        }
    },

    /**
     * Export job profile analysis to CSV in report format
     */
    async exportJobProfileToCSV() {
        try {
            const selectedJob = SkillEngine.JobExplorerController.state.selectedJob;
            if (!selectedJob) {
                alert('Please select a job profile first');
                return;
            }

            console.log('📊 Generating CSV export for:', selectedJob.title);

            // Gather all data from the page
            const exportData = await this.gatherExportData(selectedJob);
            
            // Generate CSV content in report format
            const csvContent = this.generateCSVReport(exportData);
            
            // Create and download file
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            
            const link = document.createElement('a');
            link.href = url;
            link.download = `job_profile_report_${selectedJob.id}_${new Date().toISOString().split('T')[0]}.csv`;
            link.style.display = 'none';
            
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            
            URL.revokeObjectURL(url);
            
            console.log('✅ CSV export completed successfully');
            
        } catch (error) {
            console.error('Error exporting CSV:', error);
            alert('Failed to export CSV. Please try again.');
        }
    },

    /**
     * Gather all data for export from various sections
     */
    async gatherExportData(selectedJob) {
        const data = {
            // Basic job information
            job: {
                id: selectedJob.id,
                title: selectedJob.title,
                function: selectedJob.function,
                profileId: selectedJob.profileId || selectedJob.id
            },
            timestamp: new Date(),
            
            // Job architecture info from sidebar
            architecture: this.extractJobArchitectureData(),
            
            // Enhanced skills data with categories
            skills: this.extractEnhancedSkillsData(),
            
            // Job intelligence metrics
            intelligence: this.extractIntelligenceData(),
            
            // Detailed job intelligence breakdown
            definingSkills: this.extractDefiningSkillsDetails(),
            rareSkills: this.extractRareSkillsDetails(),
            specialisedSkills: this.extractSpecialisedSkillsDetails(),
            
            // Workforce context
            workforce: this.extractWorkforceData(),
            
            // Detailed workforce distribution
            workforceDistribution: this.extractWorkforceDistributionData(),
            
            // Career pathways
            pathways: this.extractCareerPathwaysData(),
            
            // Clustered job family information
            clusteredJobFamily: this.extractClusteredJobFamilyData(),
            
            // Strategic intelligence
            strategicIndicators: this.extractStrategicIndicators(),
            
            // Context insights
            contextInsights: this.extractContextInsights()
        };

        return data;
    },

    /**
     * Extract job architecture data from sidebar
     */
    extractJobArchitectureData() {
        const getTextById = (id) => {
            const element = document.getElementById(id);
            return element ? element.textContent.trim() : 'N/A';
        };

        return {
            requiredSkills: getTextById('sidebar-skills-count'),
            positionTypes: getTextById('sidebar-positions-count'),
            totalEmployees: getTextById('sidebar-employees-count'),
            careerPathways: getTextById('sidebar-pathways-count'),
            jobProfileId: getTextById('sidebar-job-profile-id'),
            jobId: getTextById('sidebar-job-id'),
            jobName: getTextById('sidebar-job-name'),
            jobFunction: getTextById('sidebar-job-function'),
            managementLevel: getTextById('sidebar-management-level'),
            jobCategory: getTextById('sidebar-job-category'),
            jobSubfunction: getTextById('sidebar-job-subfunction')
        };
    },

    /**
     * Extract skills data from the skills sections
     */
    extractSkillsData() {
        const skillsContainer = document.getElementById('skills-by-category');
        const skills = [];
        
        if (skillsContainer) {
            // Extract skills from the dynamically generated content
            const skillBadges = skillsContainer.querySelectorAll('span[class*="items-center"]');
            skillBadges.forEach(badge => {
                const skillName = badge.textContent.replace('★', '').trim();
                const isDefining = badge.textContent.includes('★');
                
                skills.push({
                    name: skillName,
                    isDefining: isDefining,
                    category: 'General' // Could be enhanced to extract category
                });
            });
        }

        return skills;
    },

    /**
     * Extract job intelligence metrics
     */
    extractIntelligenceData() {
        const getTextById = (id) => {
            const element = document.getElementById(id);
            return element ? element.textContent.trim() : '0';
        };

        return {
            definingSkills: getTextById('job-defining-skills-count'),
            rareSkills: getTextById('job-rare-skills-count'),
            jobFamily: getTextById('job-family-size'),
            specialisedSkills: getTextById('job-specialised-skills-count')
        };
    },

    /**
     * Extract workforce context data
     */
    extractWorkforceData() {
        const getTextById = (id) => {
            const element = document.getElementById(id);
            return element ? element.textContent.trim() : '0';
        };

        return {
            totalPositions: getTextById('total-positions'),
            divisionsRepresented: getTextById('divisions-represented'),
            locationsSpread: getTextById('locations-spread')
        };
    },

    /**
     * Extract career pathways data
     */
    extractCareerPathwaysData() {
        const pathwaysContainer = document.getElementById('similar-jobs-list');
        const pathways = [];
        
        if (pathwaysContainer) {
            const pathwayItems = pathwaysContainer.querySelectorAll('[class*="pathway"]');
            pathwayItems.forEach(item => {
                const title = item.querySelector('[class*="title"]')?.textContent || '';
                const similarity = item.querySelector('[class*="similarity"]')?.textContent || '';
                
                if (title) {
                    pathways.push({
                        title: title.trim(),
                        similarity: similarity.trim()
                    });
                }
            });
        }

        return pathways;
    },

    /**
     * Extract job family data
     */
    extractJobFamilyData() {
        const jobFamilyContainer = document.getElementById('job-family-content');
        const familyData = {
            name: 'N/A',
            size: 'N/A',
            description: 'N/A'
        };

        if (jobFamilyContainer) {
            const familyName = jobFamilyContainer.querySelector('[class*="font-medium"]');
            const familySize = jobFamilyContainer.querySelector('[class*="text-lg"]');
            const description = jobFamilyContainer.querySelector('[class*="text-xs"]');

            if (familyName) familyData.name = familyName.textContent.trim();
            if (familySize) familyData.size = familySize.textContent.trim();
            if (description) familyData.description = description.textContent.trim();
        }

        return familyData;
    },

    /**
     * Extract strategic indicators data
     */
    extractStrategicIndicators() {
        const indicatorsContainer = document.getElementById('strategic-indicators');
        const indicators = [];

        if (indicatorsContainer) {
            const indicatorCards = indicatorsContainer.querySelectorAll('[class*="p-4"]');
            indicatorCards.forEach(card => {
                const title = card.querySelector('[class*="font-medium"]')?.textContent || '';
                const value = card.querySelector('[class*="text-2xl"]')?.textContent || '';
                
                if (title && value) {
                    indicators.push({
                        metric: title.trim(),
                        value: value.trim()
                    });
                }
            });
        }

        return indicators;
    },

    /**
     * Generate CSV content in report format
     */
    generateCSVReport(data) {
        const lines = [];
        const addLine = (content) => lines.push(content);
        const addSection = (title) => {
            addLine('');
            addLine(`"=== ${title} ==="`);
        };

        // Header
        addLine('"Job Profile Analysis Report"');
        addLine(`"Generated: ${data.timestamp.toLocaleString()}"`);
        addLine('');

        // Basic Job Information
        addSection('JOB PROFILE INFORMATION');
        addLine('"Field","Value"');
        addLine(`"Job ID","${data.job.id}"`);
        addLine(`"Job Title","${data.job.title}"`);
        addLine(`"Job Function","${data.job.function}"`);
        addLine(`"Profile ID","${data.job.profileId}"`);

        // Job Architecture
        addSection('JOB ARCHITECTURE');
        addLine('"Metric","Value"');
        Object.entries(data.architecture).forEach(([key, value]) => {
            const friendlyKey = key.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase());
            addLine(`"${friendlyKey}","${value}"`);
        });

        // Intelligence Metrics
        addSection('JOB INTELLIGENCE METRICS');
        addLine('"Metric","Count"');
        addLine(`"Defining Skills","${data.intelligence.definingSkills}"`);
        addLine(`"Rare Skills","${data.intelligence.rareSkills}"`);
        addLine(`"Job Family Size","${data.intelligence.jobFamily}"`);
        addLine(`"Specialised Skills","${data.intelligence.specialisedSkills}"`);

        // Workforce Context
        addSection('WORKFORCE CONTEXT');
        addLine('"Metric","Value"');
        addLine(`"Total Positions","${data.workforce.totalPositions}"`);
        addLine(`"Divisions Represented","${data.workforce.divisionsRepresented}"`);
        addLine(`"Locations Spread","${data.workforce.locationsSpread}"`);

        // Clustered Job Family Information (differentiated from raw job families)
        addSection('CLUSTERED JOB FAMILY INFORMATION');
        addLine('"Attribute","Value"');
        addLine(`"Family Name","${data.jobFamily.name}"`);
        addLine(`"Family Size","${data.jobFamily.size}"`);
        addLine(`"Description","${data.jobFamily.description}"`);

        // Skills Analysis
        if (data.skills.length > 0) {
            addSection('SKILLS BREAKDOWN');
            addLine('"Skill Name","Is Defining Skill","Category"');
            data.skills.forEach(skill => {
                addLine(`"${skill.name}","${skill.isDefining ? 'Yes' : 'No'}","${skill.category}"`);
            });
        }

        // Career Pathways
        if (data.pathways.length > 0) {
            addSection('CAREER PATHWAYS');
            addLine('"Job Title","Similarity Score"');
            data.pathways.forEach(pathway => {
                addLine(`"${pathway.title}","${pathway.similarity}"`);
            });
        }

        // Strategic Indicators
        if (data.strategicIndicators.length > 0) {
            addSection('STRATEGIC INDICATORS');
            addLine('"Indicator","Value"');
            data.strategicIndicators.forEach(indicator => {
                addLine(`"${indicator.metric}","${indicator.value}"`);
            });
        }

        // Enhanced Job Intelligence Sections\n        // Note: These require expanded sections on the page for data collection\n        \n        // Detailed Job Intelligence Breakdown\n        if (data.definingSkills && data.definingSkills.length > 0) {\n            addSection('DEFINING SKILLS DETAILED BREAKDOWN');\n            addLine('\"Skill\",\"Category\",\"Rank\",\"Prevalence\"');\n            data.definingSkills.forEach(skill => {\n                addLine(`\"${skill.skill}\",\"${skill.category}\",\"${skill.rank}\",\"${skill.prevalence}\"`);\n            });\n        }\n\n        if (data.rareSkills && data.rareSkills.length > 0) {\n            addSection('RARE SKILLS DETAILED BREAKDOWN');\n            addLine('\"Skill\",\"Category\",\"Rarity\",\"Prevalence\"');\n            data.rareSkills.forEach(skill => {\n                addLine(`\"${skill.skill}\",\"${skill.category}\",\"${skill.rarity}\",\"${skill.prevalence}\"`);\n            });\n        }\n\n        if (data.specialisedSkills && data.specialisedSkills.length > 0) {\n            addSection('SPECIALISED SKILLS DETAILED BREAKDOWN');\n            addLine('\"Skill\",\"Category\",\"Specialisation\",\"Prevalence\",\"Strategic Importance\"');\n            data.specialisedSkills.forEach(skill => {\n                addLine(`\"${skill.skill}\",\"${skill.category}\",\"${skill.specialisation}\",\"${skill.prevalence}\",\"${skill.strategic}\"`);\n            });\n        }\n\n        // Workforce Distribution\n        if (data.workforceDistribution && data.workforceDistribution.length > 0) {\n            addSection('ORGANISATIONAL DISTRIBUTION');\n            addLine('\"Division\",\"Business Unit\",\"Location\",\"Total Positions\"');\n            data.workforceDistribution.forEach(dist => {\n                addLine(`\"${dist.division}\",\"${dist.businessUnit}\",\"${dist.location}\",\"${dist.positions}\"`);\n            });\n        }\n\n        // Context Insights\n        if (data.contextInsights && data.contextInsights.length > 0) {\n            addSection('WORKFORCE CONTEXT INSIGHTS');\n            addLine('\"Type\",\"Title\",\"Description\"');\n            data.contextInsights.forEach(insight => {\n                addLine(`\"${insight.icon}\",\"${insight.title}\",\"${insight.description}\"`);\n            });\n        }\n\n        // Footer
        addLine('');
        addLine('"Report generated by NAB Skills Intelligence Platform"');
        addLine(`"Job Profile Explorer V2 - ${window.location.href}"`);

        return lines.join('\n');
    }
};

# Enhanced Skills Development Template
# Provides specific skill names and development approach using real data

meta:
  name: "skills_development"
  type: "enhanced_content"
  purpose: "Specific skills development narrative with named competencies"

content: |
  **Foundation Skills**: Direct transferability in {shared_skills_list}
  
  {development_categories_text}
  
  **Development Summary**: {shared_skills_count} transferable skills provide strong foundation, with focused development required in {total_skills_to_develop} additional competencies.

variables:
  shared_skills_list:
    description: "Comma-separated list of shared skill names"
    type: "string"
    
  shared_skills_count:
    description: "Number of shared skills between roles"
    type: "integer"
    
  development_categories:
    description: "List of skill categories requiring development"
    type: "array"
    
  total_skills_to_develop:
    description: "Total number of skills requiring development"
    type: "integer"
    
  development_categories_text:
    description: "Formatted text for development categories"
    type: "string"
    computed: true
    logic: |
      # This would be computed by the personalizer to format development categories
      # Example: "**Technical Skills Development**: Focus on Python, SQL, Data Analysis" 
